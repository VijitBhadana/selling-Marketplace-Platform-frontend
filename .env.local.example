NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public site URL used for canonical links, sitemap.xml, robots.txt and OG tags.
# Optional: when unset, `next dev` uses http://localhost:3000 and production
# builds use https://dukancloude.com. Only set it for a different host.
# NEXT_PUBLIC_SITE_URL=https://dukancloude.com

# Search engine ownership (HTML-tag method) — paste only the content="..." value.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
